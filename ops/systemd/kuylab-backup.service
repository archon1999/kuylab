[Unit]
Description=KuyLab database and media backup
Requires=docker.service
After=docker.service
ConditionPathExists=/opt/kuylab/current-release

[Service]
Type=oneshot
ExecStart=/bin/bash /opt/kuylab/repository/ops/backup.sh
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=15min
